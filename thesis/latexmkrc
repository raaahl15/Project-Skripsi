# latexmk config for the thesis (used locally and by GitHub Actions).
# The class uses nomencl: build the "Daftar Lambang dan Singkatan" with makeindex.
add_cus_dep('nlo', 'nls', 0, 'makenlo2nls');
sub makenlo2nls {
    system("makeindex \"$_[0].nlo\" -s nomencl.ist -o \"$_[0].nls\"");
}
push @generated_exts, 'nlo', 'nls', 'ilg';
